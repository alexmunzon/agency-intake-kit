<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Intake report {{ m.run_id }}</title>
<style>
:root { --bg: #f8fafc; --card: #fff; --text: #0f172a; --muted: #475569; --line: #e2e8f0;
  --ok: #059669; --warn: #d97706; --bad: #e11d48; --accent: #4f46e5; }
@media (prefers-color-scheme: dark) {
  :root { --bg: #020617; --card: #0f172a; --text: #f1f5f9; --muted: #94a3b8; --line: #1e293b;
    --ok: #34d399; --warn: #fbbf24; --bad: #fb7185; --accent: #818cf8; } }
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text);
  font: 14px/1.5 Inter, system-ui, -apple-system, "Segoe UI", sans-serif; }
main { max-width: 1120px; margin: 0 auto; padding: 32px 16px; }
h1 { font-size: 24px; margin: 0 0 4px; } h2 { font-size: 18px; margin: 32px 0 8px; }
.muted { color: var(--muted); } .mono, td.mono { font-family: ui-monospace, Menlo, monospace; }
.banner { border: 2px solid var(--line); border-left-width: 8px; border-radius: 8px;
  background: var(--card); padding: 16px 20px; margin: 16px 0; }
.banner.PASSED { border-color: var(--ok); } .banner.PASSED_WITH_WARNINGS { border-color: var(--warn); }
.banner.FAILED { border-color: var(--bad); }
.banner strong { font-size: 18px; display: block; }
.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
.tile { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 12px; }
.tile b { display: block; font-size: 24px; font-variant-numeric: tabular-nums; }
.scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; background: var(--card); }
table { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
th, td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
th { font-weight: 600; color: var(--muted); } td.num, th.num { text-align: right; }
</style>
</head>
<body>
<main>
<h1>What needs review before handoff?</h1>
<p class="muted">Run <span class="mono">{{ m.run_id }}</span>, engine {{ m.engine_version }},
{% if m.as_of %}frozen clock {{ m.as_of.isoformat() }}{% else %}started {{ m.started_at.isoformat() }}{% endif %}.
Run time: {{ run_time }}. Synthetic data only.</p>

<section class="banner {{ m.status.value }}" aria-label="Run status" data-status="{{ m.status.value }}">
<strong>{{ answer }}</strong>
<p>This is a data-check result, not agency go-live approval. Review source readiness, excluded rows, identity holds and financial differences before handoff.</p>
<span>Status: {{ status_words }}.{% if m.status_reason %} {{ m.status_reason }}{% endif %}</span>
</section>

<div class="tiles">
<div class="tile">Rows received<b>{{ card.rows_in | count }}</b></div>
<div class="tile">Rows mapped<b>{{ card.rows_mapped | count }}</b></div>
<div class="tile">Rows ready to load<b>{{ card.rows_clean | count }}</b></div>
<div class="tile">Blockers<b>{{ card.exceptions_by_severity.blocker | count }}</b></div>
<div class="tile">Errors<b>{{ card.exceptions_by_severity.error | count }}</b></div>
<div class="tile">Warnings<b>{{ card.exceptions_by_severity.warning | count }}</b></div>
<div class="tile">Info notes<b>{{ card.exceptions_by_severity.info | count }}</b></div>
<div class="tile">Policies sold without ready-to-sell status<b>{{ rts_policies | count }}</b></div>
<div class="tile">Jev calls<b>{{ m.jev.calls | count }}</b>{{ m.jev.mode.value }} mode, about ${{ m.jev.estimated_cost_usd }}{% if m.budget_tripped %}, spend cap reached{% endif %}</div>
</div>

<h2>Files received</h2>
<div class="scroll"><table>
<tr><th>Source</th><th>File</th><th class="num">Rows expected</th><th class="num">Rows received</th></tr>
{% for f in m.inputs %}
<tr><td class="mono">{{ f.source }}</td><td class="mono">{{ f.file_name }}</td>
<td class="num">{{ f.rows_expected | count }}</td><td class="num">{{ f.rows_received | count }}{% if f.rows_expected is not none and f.rows_expected != f.rows_received %} (short by {{ (f.rows_expected - f.rows_received) | count }}){% endif %}</td></tr>
{% endfor %}
</table></div>

<h2>Does the money agree?</h2>
<div class="scroll"><table>
<tr><th>Check</th><th>Result</th><th class="num">Matched</th><th class="num">Unmatched</th><th class="num">Differences</th><th class="num">Dollars</th></tr>
{% for name, leg in legs %}
<tr><td>{{ name }}</td>
{% if leg.status.value == "RAN" %}<td>Ran</td><td class="num">{{ leg.matched | count }}</td><td class="num">{{ leg.unmatched | count }}</td><td class="num">{{ leg.variance_count | count }}</td><td class="num">{{ leg.variance_dollars | money }}</td>
{% else %}<td colspan="5">Not checked. {{ leg.not_run_reason }}</td>{% endif %}</tr>
{% endfor %}
</table></div>
{% if totals.status.value == "RAN" %}
<h2>Totals by carrier</h2>
<div class="scroll"><table>
<tr><th>Carrier</th><th class="num">Book expected</th><th class="num">Statement paid</th><th class="num">Difference</th><th class="num">Unexplained revenue</th><th>Within 0.5 percent</th></tr>
{% for r in totals.rows %}
<tr><td>{{ r.key }}</td><td class="num">{{ r.book_expected | money }}</td><td class="num">{{ r.statement_paid | money }}</td><td class="num">{{ r.difference | money }}</td><td class="num">{{ r.unexplained_revenue | money }}</td><td>{{ "Yes" if r.within_tolerance else "No" }}</td></tr>
{% endfor %}
</table></div>
{% endif %}

<h2>What needs fixing, in order</h2>
{% if records %}
<div class="scroll"><table>
<tr><th>Severity</th><th>Rule</th><th>Where</th><th>Problem</th><th>Suggested fix</th></tr>
{% for r in records %}
<tr><td>{{ r.severity.value.title() }}</td><td class="mono">{{ r.rule_id }}</td>
<td class="mono">{{ r.lineage.source_file if r.lineage else r.source }}{% if r.row_number %} row {{ r.row_number }}{% endif %}</td>
<td>{{ r.message }}</td><td>{{ r.suggested_fix or "" }}</td></tr>
{% endfor %}
</table></div>
{% if more %}<p class="muted">{{ more | count }} more in exceptions.jsonl.</p>{% endif %}
<h2>Problems by rule</h2>
<div class="scroll"><table>
<tr><th>Rule</th><th class="num">Count</th></tr>
{% for rule, n in by_rule %}<tr><td class="mono">{{ rule }}</td><td class="num">{{ n | count }}</td></tr>
{% endfor %}
</table></div>
{% else %}
<p>Nothing to fix.</p>
{% endif %}

{% if detection %}
<h2>Accuracy against the planted defects</h2>
<p class="muted">False positives on clean rows: {{ detection.false_positive_rate | pct }}.</p>
<div class="scroll"><table>
<tr><th>Defect type</th><th>Scored</th><th class="num">Planted</th><th class="num">Detected</th></tr>
{% for c in detection.classes %}
<tr><td class="mono">{{ c.defect_class }}</td><td>{{ "Yes" if c.scored else "No, reported only" }}</td><td class="num">{{ c.planted | count }}</td><td class="num">{{ c.detected | count }}</td></tr>
{% endfor %}
</table></div>
{% endif %}
<p class="muted">Load files: {{ "written to clean/" if clean else "not written" }}.</p>
</main>
</body>
</html>
