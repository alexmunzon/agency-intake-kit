{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Client": {
      "additionalProperties": false,
      "properties": {
        "address_line1": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Address Line1"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "City"
        },
        "client_id": {
          "minLength": 1,
          "title": "Client Id",
          "type": "string"
        },
        "dob": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dob"
        },
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Email"
        },
        "first_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "First Name"
        },
        "household_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Household Id"
        },
        "last_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Name"
        },
        "mbi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Mbi"
        },
        "phone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Phone"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "State"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "zip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Zip"
        }
      },
      "required": [
        "record_id",
        "client_id",
        "first_name",
        "last_name",
        "dob",
        "mbi",
        "phone",
        "email",
        "address_line1",
        "city",
        "state",
        "zip",
        "household_id",
        "provenance"
      ],
      "title": "Client",
      "type": "object"
    },
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "client_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Client Ids",
          "type": "array"
        },
        "person_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Person Id"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "record_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Record Ids",
          "type": "array"
        },
        "review_state": {
          "enum": [
            "not_reviewed",
            "needs_review",
            "approved",
            "rejected",
            "blocked"
          ],
          "title": "Review State",
          "type": "string"
        },
        "state": {
          "enum": [
            "resolved",
            "unresolved",
            "ambiguous",
            "unsupported"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "person_id",
        "record_ids",
        "client_ids",
        "state",
        "review_state"
      ],
      "title": "Identity",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact"
        },
        "artifact_row": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Row"
        },
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "record_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Record Ids",
          "type": "array"
        },
        "review_state": {
          "default": "needs_review",
          "enum": [
            "not_reviewed",
            "needs_review",
            "approved",
            "rejected",
            "blocked"
          ],
          "title": "Review State",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Policy": {
      "additionalProperties": false,
      "properties": {
        "client_id": {
          "minLength": 1,
          "title": "Client Id",
          "type": "string"
        },
        "effective_date": {
          "format": "date",
          "title": "Effective Date",
          "type": "string"
        },
        "line_of_business": {
          "minLength": 1,
          "title": "Line Of Business",
          "type": "string"
        },
        "plan_id": {
          "minLength": 1,
          "title": "Plan Id",
          "type": "string"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "termination_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Termination Date"
        }
      },
      "required": [
        "record_id",
        "policy_id",
        "client_id",
        "plan_id",
        "line_of_business",
        "status",
        "effective_date",
        "termination_date",
        "provenance"
      ],
      "title": "Policy",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "minLength": 1,
          "title": "Artifact",
          "type": "string"
        },
        "artifact_row": {
          "minimum": 1,
          "title": "Artifact Row",
          "type": "integer"
        },
        "mapping_version": {
          "minLength": 1,
          "title": "Mapping Version",
          "type": "string"
        },
        "raw_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Hash",
          "type": "string"
        },
        "row_number": {
          "minimum": 1,
          "title": "Row Number",
          "type": "integer"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "sheet": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sheet"
        },
        "source_file": {
          "minLength": 1,
          "title": "Source File",
          "type": "string"
        }
      },
      "required": [
        "source_file",
        "sheet",
        "row_number",
        "raw_hash",
        "run_id",
        "mapping_version",
        "artifact",
        "artifact_row"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agency_id": {
      "minLength": 1,
      "title": "Agency Id",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "clients": {
      "items": {
        "$ref": "#/$defs/Client"
      },
      "title": "Clients",
      "type": "array"
    },
    "data_kind": {
      "const": "synthetic",
      "title": "Data Kind",
      "type": "string"
    },
    "identities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Identity"
      },
      "title": "Identities",
      "type": "array"
    },
    "intake_run_id": {
      "minLength": 1,
      "title": "Intake Run Id",
      "type": "string"
    },
    "issues": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    },
    "policies": {
      "items": {
        "$ref": "#/$defs/Policy"
      },
      "title": "Policies",
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "agency_id",
    "run_id",
    "intake_run_id",
    "data_kind",
    "artifacts",
    "clients",
    "policies"
  ],
  "title": "Packet",
  "type": "object"
}
