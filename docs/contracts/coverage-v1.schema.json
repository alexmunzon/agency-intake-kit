{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "agency_id": {
          "minLength": 1,
          "title": "Agency Id",
          "type": "string"
        },
        "client_id": {
          "minLength": 1,
          "title": "Client Id",
          "type": "string"
        },
        "county": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "County"
        },
        "plan_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Plan Id"
        },
        "plan_year": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 2000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Plan Year"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "agency_id",
        "client_id",
        "policy_id",
        "plan_id",
        "plan_year",
        "county",
        "provenance"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "minLength": 1,
          "title": "Artifact",
          "type": "string"
        },
        "artifact_row": {
          "minimum": 1,
          "title": "Artifact Row",
          "type": "integer"
        },
        "mapping_version": {
          "minLength": 1,
          "title": "Mapping Version",
          "type": "string"
        },
        "raw_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Hash",
          "type": "string"
        },
        "row_number": {
          "minimum": 1,
          "title": "Row Number",
          "type": "integer"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "sheet": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sheet"
        },
        "source_file": {
          "minLength": 1,
          "title": "Source File",
          "type": "string"
        }
      },
      "required": [
        "source_file",
        "sheet",
        "row_number",
        "raw_hash",
        "run_id",
        "mapping_version",
        "artifact",
        "artifact_row"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "data_kind": {
      "const": "synthetic",
      "title": "Data Kind",
      "type": "string"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/Coverage"
      },
      "title": "Rows",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "data_kind",
    "artifacts",
    "rows"
  ],
  "title": "CoverageFile",
  "type": "object"
}
